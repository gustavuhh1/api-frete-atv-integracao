generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatusEntrega {
  PENDENTE
  EM_TRAFEGO
  ENTREGUE
  CANCELADO
}

model Produto {
  id        Int       @id @default(autoincrement())
  nome      String
  descricao String
  preco     Float
  quantidade Int
  peso      Float
  importado Boolean  @default(false)
  categoria String
  entregas  Entrega[]
}

model Entrega {
  id             Int           @id @default(autoincrement())
  // Endereço de destino (preenchido via ViaCEP)
  cepDestino     String
  rua            String
  bairro         String
  cidade         String
  uf             String
  estado         String
  complemento    String
  numero         String
  tipoResidencia String
  // Endereço de origem
  cepOrigem      String
  // Calculados automaticamente
  distancia      Float
  taxaImposto    Float
  taxaFrete      Float
  // Produto associado
  produtoId      Int
  produto        Produto       @relation(fields: [produtoId], references: [id])
  // Status
  status         StatusEntrega @default(PENDENTE)
  // Pessoas
  remetente      String
  destinatario   String
}
